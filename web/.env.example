# Browser-visible values only. Never include private keys, signing secrets or private RPC credentials.
# Mock by default. false enables direct Arkiv / Sepolia readers.
VITE_USE_MOCK_DATA=true
# NEXT_PUBLIC_USE_MOCK_DATA is also recognized if the VITE toggle is unset.
# Legacy backend mode: leave both toggles unset and configure this URL.
VITE_REDRESS_API_URL=
VITE_ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
# Public origin-restricted access key; omit to use the rate-limited public RPC.
VITE_ARKIV_ACCESS_KEY=
# Trusted publisher is REQUIRED for live verdict reads. Never query arbitrary publishers as proof.
VITE_ARKIV_PUBLISHER=
VITE_SEPOLIA_RPC_URL=
VITE_WETH_ADDRESS=
VITE_OPERATOR_BOND_ADDRESS=
VITE_REDRESS_VAULT_ADDRESS=
VITE_RECOVERY_ADDRESS=
